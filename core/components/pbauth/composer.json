{
  "name": "boshnik/pbauth",
  "description": "pbAuth - authentication, registration and user profiles for PageBlocks",
  "type": "project",
  "authors": [
    {
      "name": "Aleksandr Huz",
      "email": "pageblocks@boshnik.com",
      "homepage": "https://github.com/Boshnik"
    }
  ],
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "Boshnik\\PbAuth\\": "src/"
    }
  },
  "config": {
